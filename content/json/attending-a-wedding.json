  "korean_scripts": [
    {
      "sentence_order": 1,
      "korean_text": "안녕하세요! 곧 친구 결혼식에 가는데, 무엇을 입어야 할지 모르겠어요."
    },
    {
      "sentence_order": 2,
      "korean_text": "보통 정장을 입으면 괜찮아요. 아니면 깔끔한 원피스도 좋아요."
    },
    {
      "sentence_order": 3,
      "korean_text": "선물을 꼭 챙겨야 하나요?"
    },
    {
      "sentence_order": 4,
      "korean_text": "축의금을 내는 것이 일반적이에요."
    },
    {
      "sentence_order": 5,
      "korean_text": "얼마 정도 내는 게 좋을까요?"
    },
    {
      "sentence_order": 6,
      "korean_text": "보통 5만원 또는 10만원 정도 준비해요."
    },
    {
      "sentence_order": 7,
      "korean_text": "걱정 마세요, 잘 다녀오세요!"
    }
  ],
