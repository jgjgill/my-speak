  "korean_scripts": [
    {
      "sentence_order": 1,
      "korean_text": "안녕하세요, 치과 의사 선생님."
    },
    {
      "sentence_order": 2,
      "korean_text": "어서 오세요. 어떻게 오셨나요?"
    },
    {
      "sentence_order": 3,
      "korean_text": "이가 너무 아파서 왔어요."
    },
    {
      "sentence_order": 4,
      "korean_text": "언제부터 아프기 시작했나요?"
    },
    {
      "sentence_order": 5,
      "korean_text": "어제 밤부터 계속 아팠어요."
    },
    {
      "sentence_order": 6,
      "korean_text": "어떤 증상이 있으신가요?"
    },
    {
      "sentence_order": 7,
      "korean_text": "음식을 씹을 때 특히 더 아파요."
    },
    {
      "sentence_order": 8,
      "korean_text": "알겠습니다. 한번 살펴볼게요."
    }
  ],
