  "korean_scripts": [
    {
      "sentence_order": 1,
      "korean_text": "안녕하세요, 새 프로젝트의 타임라인에 대해 논의하고 싶습니다."
    },
    {
      "sentence_order": 2,
      "korean_text": "물론이죠. 어떻게 생각하시나요?"
    },
    {
      "sentence_order": 3,
      "korean_text": "제 생각에는 현재 마감일이 너무 촉박한 것 같습니다."
    },
    {
      "sentence_order": 4,
      "korean_text": "테스트를 위해 더 많은 시간이 필요할 것 같습니다."
    },
    {
      "sentence_order": 5,
      "korean_text": "수정된 타임라인 제안은 무엇인가요?"
    },
    {
      "sentence_order": 6,
      "korean_text": "최종 납품일을 2주 뒤로 늦추는 것은 어떨까요?"
    },
    {
      "sentence_order": 7,
      "korean_text": "그게 더 관리하기 쉬울 것 같습니다."
    },
    {
      "sentence_order": 8,
      "korean_text": "그렇게 합시다."
    }
  ],
