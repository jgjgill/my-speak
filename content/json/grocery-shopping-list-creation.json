  },
  "korean_scripts": [
    {
      "sentence_order": 1,
      "korean_text": "오늘 저녁에 장 보러 가야 하는데, 뭘 좀 사 와야 할까?"
    },
    {
      "sentence_order": 2,
      "korean_text": "음, 우유랑 계란은 거의 다 떨어졌어."
    },
    {
      "sentence_order": 3,
      "korean_text": "알겠어. 빵도 하나 사자."
    },
    {
      "sentence_order": 4,
      "korean_text": "그리고 사과랑 바나나도 좀 필요해."
    },
    {
      "sentence_order": 5,
      "korean_text": "좋아. 양파랑 마늘도 있으면 좋겠어."
    },
    {
      "sentence_order": 6,
      "korean_text": "치킨도 한 마리 사서 저녁에 구워 먹을까?"
    },
    {
      "sentence_order": 7,
      "korean_text": "그거 좋지! 토마토도 몇 개만 부탁해."
    },
    {
      "sentence_order": 8,
      "korean_text": "알았어, 전부 적어둘게."
    }
  ],
