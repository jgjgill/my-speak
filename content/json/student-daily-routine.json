  "korean_scripts": [
    {
      "sentence_order": 1,
      "korean_text": "나는 아침 7시에 일어난다."
    },
    {
      "sentence_order": 2,
      "korean_text": "세수를 하고 양치질을 한다."
    },
    {
      "sentence_order": 3,
      "korean_text": "간단하게 시리얼로 아침 식사를 한다."
    },
    {
      "sentence_order": 4,
      "korean_text": "8시 반에 집에서 나와서 학교에 간다."
    },
    {
      "sentence_order": 5,
      "korean_text": "학교에서는 공부를 하고 친구들과 이야기를 나눈다."
    },
    {
      "sentence_order": 6,
      "korean_text": "저녁에는 숙제를 하고."
    },
    {
      "sentence_order": 7,
      "korean_text": "잠깐 친구와 통화한 후 잠자리에 든다."
    },
    {
      "sentence_order": 8,
      "korean_text": "이것이 나의 평범한 하루 일과이다."
    }
  ],
